<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.banphim.ui.GridPaperView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/doodle_keyboard_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.banphim.ui.PillToggleView
            android:id="@+id/btnToggleKeyboard"
            android:layout_width="150dp"
            android:layout_height="58dp"
            android:layout_marginTop="34dp" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="150dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/toggle_settings_bg"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_open_settings"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
