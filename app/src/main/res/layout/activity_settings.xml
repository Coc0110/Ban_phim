<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.banphim.ui.GridPaperView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/card_surface"
                android:minWidth="48dp"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Pen Style Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_pen_style_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgPenStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rbPenNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pen_style_normal"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rbPenGlow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pen_style_glow"
                            android:textColor="@color/text_primary" />

                        <RadioButton
                            android:id="@+id/rbPenDashed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pen_style_dashed"
                            android:textColor="@color/text_primary" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Canvas Grid Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_canvas_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_show_grid"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Sticker Outline Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sticker_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchStickerOutline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_sticker_outline"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/outlineColorSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_outline_color"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/outlineColorWhite"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/circle_swatch_bg" />

                            <View
                                android:id="@+id/outlineColorBlack"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/circle_swatch_bg" />

                            <View
                                android:id="@+id/outlineColorYellow"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/circle_swatch_bg" />

                            <View
                                android:id="@+id/outlineColorPink"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/circle_swatch_bg" />

                            <View
                                android:id="@+id/outlineColorBlue"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_swatch_bg" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>
