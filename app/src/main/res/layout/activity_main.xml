<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.banphim.ui.GridPaperView
        android:id="@+id/gridPaperBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hero Banner with integrated Enable/Disable button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/setup_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/send_pill_bg"
                android:minWidth="84dp"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_enable_keyboard"
                android:textAllCaps="false"
                android:textColor="#1E88E5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Single Settings Button -->
        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_surface"
            android:stateListAnimator="@null"
            android:text="@string/btn_open_settings"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dedicated Ad Banner Container (Play Store / AdMob ready) -->
        <FrameLayout
            android:id="@+id/adBannerSlot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/ad_slot_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/ad_placeholder_label"
                android:textColor="@color/ad_slot_text"
                android:textSize="12sp" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
