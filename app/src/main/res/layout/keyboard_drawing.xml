<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_height"
    android:minHeight="@dimen/keyboard_height">

    <com.banphim.drawing.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <!-- Top-left: Back to regular keyboard -->
        <ImageButton
            android:id="@+id/btnBackKeyboard"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|start"
            android:background="@drawable/circle_swatch_bg"
            android:contentDescription="@string/btn_back_keyboard"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_keyboard" />

        <!-- Top-right column: Color buttons, Undo/Redo right below, Clear below them -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Row 1: Pen color (left) + Background color (right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/btnPenColor"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_swatch_bg"
                    android:contentDescription="@string/btn_pen_color" />

                <View
                    android:id="@+id/btnBgColor"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/circle_swatch_bg"
                    android:contentDescription="@string/btn_bg_color" />
            </LinearLayout>

            <!-- Row 2: Undo + Redo right below the 2 color buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_swatch_bg"
                    android:contentDescription="@string/btn_undo"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_undo" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/circle_swatch_bg"
                    android:contentDescription="@string/btn_redo"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_redo" />
            </LinearLayout>

            <!-- Row 3: Clear button (only visible when ink exists on canvas) -->
            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/circle_swatch_bg"
                android:contentDescription="@string/btn_clear"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Horizontal pen slider replacing btnPenColor when active -->
        <com.banphim.drawing.ColorStripView
            android:id="@+id/stripPenColor"
            android:layout_width="@dimen/pen_strip_width"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="44dp"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Vertical background slider replacing btnBgColor when active -->
        <com.banphim.drawing.ColorStripView
            android:id="@+id/stripBgColor"
            android:layout_width="34dp"
            android:layout_height="190dp"
            android:layout_gravity="top|end"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Bottom-right: Send sticker -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/circle_swatch_bg"
            android:backgroundTint="@color/send_bg"
            android:contentDescription="@string/btn_send"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send" />

    </FrameLayout>

</FrameLayout>
