<?xml version="1.0" encoding="utf-8"?>
<!-- Khung xem nhan dan: truot de len khung ve cua ban phim thu.
     elevation cao hon cac nut noi (nut Gui 3dp, thanh mau nen 6dp) de phu kin chung -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7A808B"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true"
    android:visibility="gone">

    <ImageView
        android:id="@+id/testStickerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:padding="28dp"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnTestBack"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/test_back_bg"
        android:contentDescription="@string/btn_test_back"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron_left" />
</FrameLayout>