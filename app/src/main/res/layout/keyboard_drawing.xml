<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_height"
    android:background="#141518"
    android:minHeight="@dimen/keyboard_height"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/toolbar_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <!-- Left: Brush size icon + expandable slider + Pen color button / slider -->
        <ImageButton
            android:id="@+id/btnBrushSize"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_brush_size"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_brush" />

        <com.banphim.drawing.BrushSizeSliderView
            android:id="@+id/sliderBrushSize"
            android:layout_width="112dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:visibility="gone" />

        <View
            android:id="@+id/btnPenColor"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_swatch_bg"
            android:contentDescription="@string/btn_pen_color" />

        <com.banphim.drawing.ColorStripView
            android:id="@+id/stripPenColor"
            android:layout_width="150dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Right: Undo + Redo -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_undo"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_redo"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_redo" />
    </LinearLayout>

    <!-- Main Drawing Canvas Card -->
    <FrameLayout
        android:id="@+id/canvasCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/canvas_card_bg"
        android:clipToOutline="true">

        <com.banphim.drawing.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top-left inside canvas: Background color button & vertical slider -->
        <View
            android:id="@+id/btnBgColor"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/circle_swatch_bg"
            android:contentDescription="@string/btn_bg_color" />

        <com.banphim.drawing.ColorStripView
            android:id="@+id/stripBgColor"
            android:layout_width="30dp"
            android:layout_height="165dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Top-right inside canvas: Clear button (only visible when ink exists) -->
        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_clear"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clear"
            android:visibility="gone" />

        <!-- Bottom-right inside canvas: Send sticker pill -->
        <LinearLayout
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/send_pill_bg"
            android:clickable="true"
            android:contentDescription="@string/btn_send"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_send_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_send_short"
                android:textColor="#141518"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
